/build/
/dist/
/CMakeUserPresets.json
.vs/
/CMakeSettings.json
*.user
*.suo
*.VC.db
*.VC.VC.opendb

# Legacy Visual Studio browse databases, workspace state, and build logs.
/ide/visual-studio/**/*.ncb
/ide/visual-studio/**/*.opt
/ide/visual-studio/**/*.plg
/ide/visual-studio/**/obj/

# Open Watcom IDE/ide2make output (the descriptors themselves are tracked).
/ide/open-watcom/*.mk
/ide/open-watcom/**/*.mk1
/ide/open-watcom/**/*.obj
/ide/open-watcom/**/*.err
/ide/open-watcom/**/*.lb1
/ide/open-watcom/**/*.lib

# Runtime files belong to the user and must never be committed.
*.WL1
*.WL6
*.SOD
*.SDM
CONFIG.*
SAVEGAM?.*
